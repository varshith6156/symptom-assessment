# Backend Configuration
# Mode: "mock" (runs deterministically without external API) or "live"
LLM_MODE=mock

# External OpenAI-compatible provider settings (required if LLM_MODE=live)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Security and CORS
FRONTEND_URL=http://localhost:5173
SESSION_TTL_MINUTES=30
MAX_SESSIONS=500
MAX_TRANSCRIPT_MESSAGES=40

# Emergency contact configuration (displayed in banner and emergency flows)
# E.g. "911", "999", "112"
EMERGENCY_NUMBER=911
EMERGENCY_REGION=US / Canada
